---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import AppStoreBadge from '../../../components/AppStoreBadge.astro';
import { site, legal } from '../../../config';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => {
    const [lang, slug] = g.id.split('/');
    return { params: { lang, slug }, props: { guide: g } };
  });
}
const { guide } = Astro.props;
const { lang, slug } = Astro.params as { lang: string; slug: string };
const { Content } = await render(guide);
const d = guide.data;
const fmt = (x: Date) => x.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const url = `${site.url}/${lang}/guides/${slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    datePublished: d.published.toISOString().slice(0, 10),
    dateModified: (d.updated ?? d.published).toISOString().slice(0, 10),
    author: { '@type': 'Person', name: d.author },
    publisher: { '@type': 'Organization', name: 'Sumsnapp', '@id': `${site.url}/#org`, logo: `${site.url}/favicon.svg` },
    mainEntityOfPage: url,
    inLanguage: lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Sumsnapp', item: `${site.url}/${lang}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site.url}/${lang}/guides/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base lang={lang} path={`guides/${slug}/`} title={`${d.title} · Sumsnapp`} description={d.description} jsonLd={jsonLd}>
  <main id="top" class="wrap article">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={`/${lang}/guides/`}>Guides</a> / <span>{d.kicker}</span></nav>
    <h1>{d.title}</h1>
    <p class="meta">
      By {d.author}, {legal.business} · <time datetime={d.published.toISOString().slice(0, 10)}>{fmt(d.published)}</time>
      {d.updated && <> · Updated <time datetime={d.updated.toISOString().slice(0, 10)}>{fmt(d.updated)}</time></>}
    </p>
    <article class="prose"><Content /></article>
    <aside class="cta">
      <div>
        <h2>Track every item, privately</h2>
        <p>Sumsnapp reads your receipts on your iPhone and shows what you spend on each item, store and category. No account, no bank connection. Free for {site.free.scans} scans a month.</p>
      </div>
      <AppStoreBadge campaign={`guide-${slug}`} />
    </aside>
  </main>
</Base>

<style>
  .article { max-width: 760px; padding-top: clamp(32px, 5vw, 56px); padding-bottom: var(--section); }
  .crumbs { font-size: 14px; color: var(--text3); margin-bottom: 16px; }
  .crumbs a { text-decoration: none; }
  h1 { margin: 0; font-size: clamp(32px, 4.6vw, 48px); font-weight: 700; letter-spacing: -.02em; line-height: 1.08; text-wrap: balance; }
  .meta { margin: 14px 0 36px; font-size: 15px; color: var(--text3); }
  .prose { font-size: 18px; line-height: 1.65; }
  .prose :global(h2) { font-size: 26px; letter-spacing: -.01em; line-height: 1.25; margin: 44px 0 12px; }
  .prose :global(h3) { font-size: 20px; margin: 30px 0 8px; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 16px; color: var(--text2); }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(strong) { color: var(--fg); }
  .prose :global(blockquote) { margin: 0 0 18px; padding: 14px 18px; border-radius: 16px; background: var(--card); color: var(--fg); }
  .prose :global(blockquote p) { margin: 0; color: inherit; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 20px; font-size: 15px; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; vertical-align: top; padding: 10px 12px; border-bottom: .5px solid var(--sep2); }
  .prose :global(th) { font-size: 13px; color: var(--text3); font-weight: 600; white-space: nowrap; }
  .prose :global(td) { color: var(--text2); }
  .prose :global(.sources) { font-size: 15px; }
  .cta { margin-top: 48px; padding: 24px; border-radius: 24px; background: var(--accent-soft); display: flex; flex-wrap: wrap; gap: 18px; align-items: center; justify-content: space-between; }
  .cta h2 { margin: 0 0 6px; font-size: 22px; }
  .cta p { margin: 0; color: var(--text2); line-height: 1.5; max-width: 460px; }
</style>
