---
import Base from '../../layouts/Base.astro';
import Accordion from '../../components/Accordion.astro';
import Icon from '../../components/Icon.astro';
import { SUPPORT, contactNote } from '../../data/support';
import { legal, locales } from '../../config';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: string };

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: SUPPORT.flatMap((t) => t.items).map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
}];
---
<Base lang={lang} path="support/" title="Help and support · Sumsnapp" jsonLd={jsonLd}
  description="Help with Sumsnapp: scanning receipts, fixing totals, insights and questions, plans and billing, cancelling, privacy and contact.">
  <main id="top" class="wrap support">
    <header class="head">
      <h1>Help and support</h1>
      <p class="lead">Answers to common questions about Sumsnapp. Can't find yours? <a href={`mailto:${legal.email}`}>Email us</a>.</p>
      <nav class="topics" aria-label="Topics">
        {SUPPORT.map((t) => <a href={`#${t.id}`}>{t.title}</a>)}
      </nav>
    </header>

    {SUPPORT.map((t) => (
      <section id={t.id} class="topic">
        <h2>{t.title}</h2>
        <Accordion items={t.items} />
      </section>
    ))}

    <section id="contact" class="contact">
      <Icon name="mark_email_read" size={28} />
      <div>
        <h2>Still need help?</h2>
        <p>{contactNote} Include your iPhone model and iOS version, and a screenshot if something looks wrong. Please don't send photos of receipts with personal details on them.</p>
        <a class="mail" href={`mailto:${legal.email}?subject=Sumsnapp%20support`}>{legal.email}</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .support { max-width: 880px; padding-top: clamp(32px, 5vw, 64px); padding-bottom: var(--section); }
  .head h1 { margin: 0 0 12px; font-size: clamp(34px, 5vw, 56px); font-weight: 700; letter-spacing: -.02em; line-height: 1.05; }
  .topics { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .topics a { min-height: 40px; padding: 0 14px; border-radius: 20px; background: var(--card); color: inherit; text-decoration: none; display: flex; align-items: center; font-size: 15px; font-weight: 500; }
  .topics a:hover { color: var(--accent); }
  .topic { margin-top: 48px; scroll-margin-top: 80px; }
  .topic h2 { margin: 0 0 12px; font-size: 26px; letter-spacing: -.01em; }
  .contact { margin-top: 56px; padding: 24px; border-radius: 24px; background: var(--accent-soft); display: flex; gap: 16px; align-items: flex-start; scroll-margin-top: 80px; }
  .contact > :global(.icon) { color: var(--accent); }
  .contact h2 { margin: 0 0 8px; font-size: 22px; }
  .contact p { margin: 0 0 12px; color: var(--text2); line-height: 1.55; }
  .mail { font-weight: 600; font-size: 17px; }
</style>
