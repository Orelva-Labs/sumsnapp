---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, locales, launched } from '../config';

interface Props {
  lang: string;
  title: string;
  description: string;
  /** Path after the language, e.g. "" for home or "privacy-policy/". */
  path?: string;
  jsonLd?: object[];
  /** Keep the page out of search results (e.g. a legal page still missing details). */
  noindex?: boolean;
}
const { lang, title, description, path = '', jsonLd = [], noindex = false } = Astro.props;
const url = (l: string) => new URL(`/${l}/${path}`, site.url).href;
const appId = site.appStoreUrl.match(/id(\d+)/)?.[1];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url(lang)} />
    {noindex && <meta name="robots" content="noindex" />}
    {locales.map((l) => <link rel="alternate" hreflang={l} href={url(l)} />)}
    <link rel="alternate" hreflang="x-default" href={url('en')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F2F2F7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    {appId && <meta name="apple-itunes-app" content={`app-id=${appId}`} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sumsnapp" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:locale" content={lang} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <script is:inline>
      // Before first paint: the saved theme, and whether animations will play (so their end frame doesn't flash).
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      setTimeout(() => document.documentElement.classList.remove('motion'), 3000);
    </script>
  </head>
  <body>
    <a class="skip sr-only" href="#top">Skip to content</a>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>

<style>
  .skip:focus { position: fixed; left: 12px; top: 12px; width: auto; height: auto; clip: auto; z-index: 50;
    padding: 10px 14px; border-radius: 10px; background: var(--card); }
</style>
