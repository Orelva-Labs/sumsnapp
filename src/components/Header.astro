---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { locales, languageNames } from '../config';

interface Props { lang: string }
const { lang } = Astro.props;
// Full paths, so the links also work from other pages; on the home page they just scroll.
const links = [['how', 'How it works'], ['privacy', 'Privacy'], ['pricing', 'Pricing'], ['faq', 'FAQ']].map(([id, label]) => [`/${lang}/#${id}`, label]);
---
<header class="header">
  <nav class="wrap bar" aria-label="Main">
    <a href={`/${lang}/`} class="home" aria-label="Sumsnapp home"><Logo /></a>
    <div class="links">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </div>
    <div class="tools">
      {locales.length > 1 && (
        <div class="lang">
          <button type="button" aria-label="Language" aria-expanded="false" aria-controls="lang-menu" data-toggle="lang-menu">
            <Icon name="language" size={20} />{lang.toUpperCase()}
          </button>
          <ul id="lang-menu" class="menu" hidden>
            {locales.map((l) => (
              <li><a href={`/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
                {languageNames[l]}{l === lang && <Icon name="check" size={18} />}
              </a></li>
            ))}
          </ul>
        </div>
      )}
      <button type="button" class="theme" data-theme-toggle aria-label="Change theme">
        <Icon name="brightness_auto" size={22} class="t-system" />
        <Icon name="light_mode" size={22} class="t-light" />
        <Icon name="dark_mode" size={22} class="t-dark" />
      </button>
      <button type="button" class="burger" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav" data-toggle="mobile-nav">
        <Icon name="menu" size={24} class="open" /><Icon name="close" size={24} class="shut" />
      </button>
    </div>
  </nav>
  <div id="mobile-nav" class="wrap mobile" hidden>
    {links.map(([href, label]) => <a href={href} data-close="mobile-nav">{label}</a>)}
  </div>
</header>

<script>
  // Menus: one toggle button each; links inside the mobile menu close it.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-toggle]')) {
    const panel = document.getElementById(btn.dataset.toggle!)!;
    btn.addEventListener('click', () => {
      const open = panel.hidden;
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    });
  }
  for (const a of document.querySelectorAll<HTMLElement>('[data-close]')) {
    a.addEventListener('click', () => {
      document.getElementById(a.dataset.close!)!.hidden = true;
      document.querySelector(`[data-toggle="${a.dataset.close}"]`)?.setAttribute('aria-expanded', 'false');
    });
  }
  // Theme: system → light → dark, remembered on this device only.
  const order = ['system', 'light', 'dark'];
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const label = (t: string) => `Theme: ${t === 'system' ? 'follows system' : t}. Change theme`;
  const apply = (t: string) => {
    if (t === 'system') delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = t;
    btn.dataset.mode = t;
    btn.setAttribute('aria-label', label(t));
    btn.title = label(t);
  };
  let current = 'system';
  try { current = localStorage.getItem('theme') || 'system'; } catch {}
  apply(current);
  btn.addEventListener('click', () => {
    current = order[(order.indexOf(current) + 1) % order.length];
    apply(current);
    try { current === 'system' ? localStorage.removeItem('theme') : localStorage.setItem('theme', current); } catch {}
  });
</script>

<style>
  .header {
    position: sticky; top: 0; z-index: 20;
    background: light-dark(rgba(242, 242, 247, .82), rgba(0, 0, 0, .78));
    backdrop-filter: blur(20px) saturate(1.6); -webkit-backdrop-filter: blur(20px) saturate(1.6);
    border-bottom: .5px solid var(--sep);
  }
  .bar { height: 64px; display: flex; align-items: center; gap: 20px; }
  .home { color: inherit; text-decoration: none; margin-right: auto; }
  .links { display: flex; gap: 28px; font-size: 15px; font-weight: 500; }
  .links a, .mobile a { color: inherit; text-decoration: none; }
  .links a:hover, .mobile a:hover { color: var(--accent); }
  .tools { display: flex; align-items: center; gap: 4px; }
  button {
    min-width: 44px; height: 44px; padding: 0 8px; border: 0; border-radius: 10px; background: transparent;
    display: grid; place-items: center; cursor: pointer;
  }
  button:hover { background: var(--fill); }
  .lang { position: relative; }
  .lang button { display: flex; gap: 2px; font-size: 14px; font-weight: 600; }
  .menu {
    position: absolute; top: 52px; right: 0; width: 200px; margin: 0; padding: 6px; list-style: none;
    border-radius: 14px; background: var(--card); box-shadow: 0 12px 40px rgba(0, 0, 0, .18);
  }
  .menu a {
    min-height: 44px; padding: 0 12px; border-radius: 9px; display: flex; align-items: center;
    justify-content: space-between; color: inherit; text-decoration: none; font-size: 15px;
  }
  .menu a[aria-current] { background: var(--fill); }
  .menu .icon { color: var(--accent); }
  .theme .icon { display: none; }
  .theme[data-mode='system'] .t-system, .theme[data-mode='light'] .t-light, .theme[data-mode='dark'] .t-dark,
  .theme:not([data-mode]) .t-system { display: block; }
  .burger { display: none; }
  .burger .shut, .burger[aria-expanded='true'] .open { display: none; }
  .burger[aria-expanded='true'] .shut { display: block; }
  .mobile { padding-top: 4px; padding-bottom: 16px; display: flex; flex-direction: column; font-size: 17px; font-weight: 500; }
  .mobile a { min-height: 48px; display: flex; align-items: center; }
  .mobile[hidden] { display: none; }
  @media (max-width: 759px) {
    .links { display: none; }
    .burger { display: grid; }
  }
  @media (min-width: 760px) { .mobile { display: none !important; } }
</style>
