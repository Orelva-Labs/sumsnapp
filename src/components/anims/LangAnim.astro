---
// Search "milk" across receipts in four languages, and receipts in other currencies converted.
import Icon from '../Icon.astro';
import { LANGR, FX } from '../../data/anims';
---
<div class="lang-anim" data-anim="lang">
  <div class="panel">
    <div class="field"><Icon name="search" size={20} /><span data-typed>milk</span><span class="cursor" data-cursor style="opacity:0"></span></div>
    {LANGR.map((r) => (
      <div class="row ease-pop" data-langrow>
        <div class="txt">
          <span class="raw" lang={r.raw.startsWith('LAIT') ? 'fr' : r.raw.startsWith('LATTE') ? 'it' : r.raw.startsWith('LECHE') ? 'es' : 'de'}>{r.raw}</span>
          <span class="store">{r.store}<span class="tr" data-tr>{r.tr}</span></span>
        </div>
        <span class="num">{r.amt}</span>
      </div>
    ))}
  </div>
  <div class="panel">
    <div class="cap">Converted to your currency</div>
    {FX.map(([mono, c, store, from, to]) => (
      <div class="row" data-fx>
        <div class="mono-tile tile" style={`background:${c}`}>{mono}</div>
        <div class="txt"><div class="sn">{store}</div><div class="sub num" data-sub>{from} · converted at the day's rate</div></div>
        <span class="main rounded num" data-main>{to}</span>
      </div>
    ))}
    <div class="note">Rates from the European Central Bank. Only the currency codes and the date are sent.</div>
  </div>
</div>

<style>
  .lang-anim { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); }
  .panel { border-radius: 24px; background: var(--inset); padding: 18px; display: flex; flex-direction: column; gap: 10px; }
  .field { height: 46px; border-radius: 12px; background: var(--card2); display: flex; align-items: center; gap: 8px; padding: 0 12px; font-size: 17px; }
  .field .icon { color: var(--text3); }
  .cursor { width: 2px; height: 20px; background: var(--accent); margin-left: -6px; }
  .row { border-radius: 14px; background: var(--card2); padding: 10px 14px; display: flex; align-items: center; gap: 12px; }
  .txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .raw { font-family: var(--mono); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .store { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text3); flex-wrap: wrap; }
  .tr { height: 20px; padding: 0 8px; border-radius: 10px; background: var(--accent-soft); color: var(--accent); font-weight: 600; display: flex; align-items: center; transition: opacity .35s; }
  .num { font-size: 15px; }
  .cap { font-size: 13px; color: var(--text3); padding: 6px 4px 2px; text-transform: uppercase; letter-spacing: .02em; }
  .tile { width: 36px; height: 36px; border-radius: 11px; }
  .sn { font-size: 15px; }
  .sub { font-size: 13px; color: var(--text3); }
  .main { font-size: 19px; font-weight: 600; }
  .note { font-size: 13px; color: var(--text3); padding: 4px; }
</style>
