---
// A receipt is scanned top to bottom and its lines lift off into categorised item rows.
import Icon from '../Icon.astro';
import { HERO, PAPER, HERO_TOTAL, eur } from '../../data/anims';
import { cat } from '../../data/categories';
---
<div class="hero-anim" data-anim="hero" role="img" aria-label="A REWE receipt read into seven categorised items that match the receipt total of €20.16">
  <div class="receipt paper" aria-hidden="true">
    <div class="shop">REWE</div>
    <div class="c">Schönhauser Allee 80 · Berlin</div>
    <div class="c gap">23.10.2026 18:42</div>
    {PAPER.map((p) => <div class="line" data-paper style="background:rgba(30,106,76,.16)"><span class="raw">{p.raw}</span><span>{p.amt}</span></div>)}
    <div class="dash"></div>
    <div class="line b"><span>SUMME EUR</span><span>20,16</span></div>
    <div class="line"><span>MWST 7%</span><span>1,04</span></div>
    <div class="line"><span>MWST 19%</span><span>0,65</span></div>
    <div class="sweep" data-sweep></div>
  </div>
  <div class="card" aria-hidden="true">
    <div class="head">
      <div class="mono-tile store">R</div>
      <div><div class="name">REWE</div><div class="when">Fri 23 Oct · 18:42</div></div>
    </div>
    {HERO.map((h) => {
      const c = cat(h.cat);
      return (
        <div class="row ease-pop" data-row>
          <div class="item">
            <div class="cat-tile tile" style={`background:${c.color}`}><Icon name={c.icon} fill size={17} /></div>
            <div class="txt"><div class="n">{h.name}</div><div class="s num">{h.sub}</div></div>
            <span class="a num">{eur(h.v)}</span>
          </div>
          {h.disc && <div class="disc" data-disc><span>↳ Discount</span><span class="num">{h.disc[2]}</span></div>}
        </div>
      );
    })}
    <div class="foot">
      <span class="pill" data-pill><Icon name="check_circle" fill size={16} />Matches receipt total</span>
      <span class="total rounded num" data-total>{eur(HERO_TOTAL)}</span>
    </div>
  </div>
</div>

<style>
  .hero-anim { position: relative; width: 100%; height: 560px; }
  .receipt {
    position: absolute; left: 0; top: 8px; width: 54%; transform: rotate(-3deg); overflow: hidden;
    font-size: clamp(9.5px, 1vw, 11px); line-height: 1.6; padding: 18px 12px 22px; border-radius: 4px;
    box-shadow: 0 16px 40px var(--shadow);
  }
  .shop { text-align: center; font-weight: 700; font-size: 1.25em; letter-spacing: .16em; }
  .c { text-align: center; }
  .gap { margin-bottom: 10px; }
  .line { display: flex; justify-content: space-between; gap: 6px; padding: 1px 4px; border-radius: 3px; transition: background .3s; }
  .raw { white-space: pre; overflow: hidden; text-overflow: ellipsis; }
  .b { font-weight: 700; }
  .dash { border-top: 1px dashed #9A968E; margin: 8px 0; }
  .sweep {
    position: absolute; left: 0; right: 0; height: 64px; top: 96%; margin-top: -48px; opacity: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(92, 192, 143, 0), rgba(92, 192, 143, .32) 70%, rgba(92, 192, 143, .9));
    transition: top .1s linear, opacity .3s;
  }
  .card {
    position: absolute; right: 0; top: 112px; width: 66%; border-radius: 22px; overflow: hidden;
    background: var(--card); box-shadow: 0 20px 50px var(--shadow);
  }
  .head { display: flex; align-items: center; gap: 10px; padding: 14px 14px 10px; }
  .store { width: 36px; height: 36px; border-radius: 11px; background: #C0504A; font-size: 17px; }
  .name { font-size: 15px; font-weight: 600; }
  .when { font-size: 12px; color: var(--text3); }
  .item { display: flex; align-items: center; gap: 10px; padding: 7px 14px 7px 12px; border-top: .5px solid var(--sep); }
  .tile { width: 28px; height: 28px; border-radius: 8px; }
  .txt { flex: 1; min-width: 0; }
  .n, .s { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .n { font-size: 14px; }
  .s { font-size: 11.5px; color: var(--text3); }
  .a { font-size: 14px; }
  .disc { display: flex; justify-content: space-between; padding: 0 14px 7px 50px; font-size: 12.5px; transition: opacity .35s; }
  .disc span:first-child { color: var(--text3); }
  .disc span:last-child { color: var(--accent); }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 14px 14px; border-top: .5px solid var(--sep2); }
  .foot .pill { transition: opacity .3s, transform .45s cubic-bezier(.2, .9, .3, 1.6); }
  .total { font-size: 20px; font-weight: 600; }
  @media (max-width: 480px) {
    .hero-anim { height: 600px; }
    .receipt { width: 70%; }
    .card { width: 88%; top: 150px; }
  }
</style>
