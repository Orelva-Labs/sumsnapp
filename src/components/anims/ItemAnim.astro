---
// One item's price history across stores, then a price alert on today's receipt.
import Icon from '../Icon.astro';
import { MILK, MILK_PTS, STORE, ITEM_STATS, ITEM_STORES } from '../../data/anims';
---
<div class="item-anim" data-anim="item">
  <div class="panel">
    <div class="head">
      <div class="cat-tile tile"><Icon name="shopping_basket" fill size={24} /></div>
      <div><div class="name">Whole Milk 1L</div><div class="meta">Groceries · Dairy · last 3 months</div></div>
    </div>
    <dl class="stats">
      {ITEM_STATS.map(([l, v]) => <div><dt>{l}</dt><dd class="rounded num">{v}</dd></div>)}
    </dl>
    <div class="chart" role="img" aria-label="Price of Whole Milk 1L at each purchase, from €1.09 at Lidl to €1.49 at REWE">
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <polyline data-line points={MILK_PTS.map((p) => p.join(',')).join(' ')} vector-effect="non-scaling-stroke" />
      </svg>
      {MILK_PTS.map(([x, y], i) => (
        <div class:list={['dot', { 'is-alert': i === MILK.length - 1 }]} data-dot style={`left:${x}%;top:${y}%;background:${STORE[MILK[i][1]]}`}></div>
      ))}
    </div>
    <div class="legend">
      {ITEM_STORES.map(([n, a]) => <span><i style={`background:${STORE[n]}`}></i>{n} · avg {a}</span>)}
    </div>
  </div>
  <div class="receipt paper">
    <div class="rl"><span>REWE · 23.10.2026</span><span></span></div>
    <div class="rl hit" data-alertline style="background:rgba(255,190,60,.4)"><span>VOLLMILCH 3,5% 1L</span><span>1,49</span></div>
    <div class="alert" data-alert><Icon name="trending_up" fill size={18} /><span>€0.30 more than you usually pay · €1.19 at Lidl</span></div>
  </div>
</div>

<style>
  .item-anim { display: flex; flex-direction: column; gap: 14px; width: 100%; }
  .panel { border-radius: 24px; background: var(--inset); padding: 18px; }
  .head { display: flex; align-items: center; gap: 12px; }
  .tile { width: 40px; height: 40px; border-radius: 12px; background: #4F8A5B; }
  .name { font-size: 18px; font-weight: 600; }
  .meta { font-size: 13px; color: var(--text3); }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin: 14px 0 0; }
  .stats div { border-radius: 12px; background: var(--card2); padding: 10px; }
  dt { font-size: 11.5px; color: var(--text3); }
  dd { margin: 0; font-size: clamp(16px, 1.6vw, 20px); font-weight: 600; }
  .chart { position: relative; height: 120px; margin: 18px 6px 0; }
  .chart svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  polyline { fill: none; stroke: light-dark(#C7C7CC, #48484A); stroke-width: 1.5; }
  .dot {
    position: absolute; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 6px;
    border: 2px solid var(--inset); transition: opacity .3s, transform .4s cubic-bezier(.2, .9, .3, 1.6), box-shadow .3s;
  }
  .dot.is-alert { box-shadow: 0 0 0 4px rgba(194, 119, 0, .35); }
  .legend { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 14px; font-size: 13px; color: var(--text2); }
  .legend span { display: flex; align-items: center; gap: 6px; }
  .legend i { width: 9px; height: 9px; border-radius: 5px; }
  .receipt { position: relative; font-size: 12px; line-height: 1.6; padding: 12px 14px; border-radius: 6px; box-shadow: 0 10px 30px var(--shadow); }
  .rl { display: flex; justify-content: space-between; }
  .hit { padding: 1px 4px; margin: 4px -4px 0; border-radius: 3px; transition: background .3s; }
  .alert {
    margin-top: 10px; font-family: var(--font); font-size: 14px; line-height: 1.35; border-radius: 12px; padding: 10px 12px;
    background: light-dark(#FDF0DC, #3A2A0F); color: light-dark(#6B3A00, #FFD08A); display: flex; gap: 8px; align-items: flex-start;
    transition: opacity .35s, transform .45s cubic-bezier(.2, .9, .3, 1.4);
  }
  /* The receipt paper stays light in dark mode; the alert keeps its own dark-mode colours. */
</style>
