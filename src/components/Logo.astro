---
interface Props { size?: number; text?: number }
const { size = 30, text = 22 } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
    <rect width="100" height="100" rx="22.4" class="bg" />
    <path class="fg-stroke" d="M24 36V30a6 6 0 0 1 6-6h6M64 24h6a6 6 0 0 1 6 6v6M76 64v6a6 6 0 0 1-6 6h-6M36 76h-6a6 6 0 0 1-6-6v-6" />
    <rect x="36" y="37" width="28" height="6" rx="3" class="fg" />
    <rect x="36" y="47.5" width="20" height="6" rx="3" class="fg" />
    <rect x="36" y="58" width="24" height="6" rx="3" class="hi" />
  </svg>
  <span class="word" style={`font-size:${text}px`}>Sumsnapp</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 9px; }
  .bg { fill: light-dark(#1E6A4C, #0E0F0E); }
  .fg { fill: light-dark(#F7F5EF, #5CC08F); }
  .hi { fill: light-dark(#5CC08F, #F7F5EF); }
  .fg-stroke { fill: none; stroke: light-dark(#F7F5EF, #5CC08F); stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; }
  .word { font-family: var(--rounded); font-weight: 700; letter-spacing: -.02em; }
</style>
